{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ActivityTracking": {
    "Enabled": true,
    "PollingIntervalMs": 500,
    "IdleThresholdMinutes": 1,
    "WindowDebounceMs": 200
  },
  "Recording": {
    "Enabled": true,
    "SegmentMinutes": 1,
    "FrameRate": 15,
    "VideoBitrateKbps": 1000,
    "VideoQuality": 50,
    "RetentionDays": 7,
    "MaxStorageSizeGB": 10,
    "MinimumFreeDiskSpaceGB": 1
  }
}
