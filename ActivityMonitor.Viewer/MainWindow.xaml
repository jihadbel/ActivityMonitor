<Window x:Class="ActivityMonitor.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:ActivityMonitor.Viewer.ViewModels"
        mc:Ignorable="d"
        Title="مراقب الأنشطة - مستعرض التقارير ومشغل الفيديو المتزامن"
        Height="860" Width="1420"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgLightBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Light Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CardLightBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BorderLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Primary Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3730A3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 1-Click Row Play Button Style -->
        <Style x:Key="PlayRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF2FF" />
            <Setter Property="Foreground" Value="#4338CA" />
            <Setter Property="BorderBrush" Value="#C7D2FE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="border" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0. Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- 1. KPI Metric Cards -->
            <RowDefinition Height="Auto" />
            <!-- 2. Main Content Split View -->
            <RowDefinition Height="*" />
            <!-- 3. Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. TOP HEADER BAR -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceLightBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo & Arabic App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                        <TextBlock Text="▶" Foreground="White" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,2,0" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="مراقب الأنشطة" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="مستعرض الأنشطة والمشغل المحلي المتزامن" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Date Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="▶" Style="{StaticResource ActionButtonStyle}" Command="{Binding NextDayCommand}" Width="36" Margin="0,0,6,0" ToolTip="اليوم التالي" />
                    <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Width="145" Height="32" VerticalContentAlignment="Center" Background="{StaticResource SurfaceLightBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderLightBrush}" />
                    <Button Content="◀" Style="{StaticResource ActionButtonStyle}" Command="{Binding PreviousDayCommand}" Width="36" Margin="6,0,8,0" ToolTip="اليوم السابق" />
                    <Button Content="اليوم" Style="{StaticResource ActionButtonStyle}" Command="{Binding TodayCommand}" Margin="0,0,8,0" />
                    <Button Content="🔄 تحديث" Style="{StaticResource ActionButtonStyle}" Command="{Binding RefreshCommand}" />
                </StackPanel>

                <!-- Service & Agent Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Service Control Badge -->
                    <Border Background="{StaticResource CardLightBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServiceRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ServiceStatusText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Command="{Binding ToggleServiceCommand}" Padding="10,4" FontSize="11">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                        <Setter Property="Content" Value="تشغيل الخدمة" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServiceRunning}" Value="True">
                                                <Setter Property="Content" Value="إيقاف الخدمة" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Agent Control Badge -->
                    <Border Background="{StaticResource CardLightBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAgentRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding AgentStatusText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Content="تبديل العميل" Style="{StaticResource ActionButtonStyle}" Command="{Binding ToggleAgentCommand}" Padding="10,4" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- Folders -->
                    <Button Content="📁 التقارير" Style="{StaticResource ActionButtonStyle}" Command="{Binding OpenReportsFolderCommand}" Margin="0,0,6,0" ToolTip="فتح مجلد التقارير اليومية" />
                    <Button Content="🎥 التسجيلات" Style="{StaticResource ActionButtonStyle}" Command="{Binding OpenRecordingsFolderCommand}" ToolTip="فتح مجلد مقاطع الفيديو المسجلة" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. KPI SUMMARY METRIC CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Active Work Time -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="وقت العمل الفعلي" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding TotalActiveTimeDisplay}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 2: Idle Time -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4,0,8,0">
                <StackPanel>
                    <TextBlock Text="وقت خمول المستخدم" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Text="{Binding TotalIdleTimeDisplay}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 3: Top Application -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4,0,8,0">
                <StackPanel>
                    <TextBlock Text="التطبيق الأكثر استخداماً" FontSize="11" FontWeight="Bold" Foreground="#0284C7" />
                    <TextBlock Text="{Binding TopAppName}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 4: Total Events -->
            <Border Grid.Column="3" Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4,0,8,0">
                <StackPanel>
                    <TextBlock Text="إجمالي الأحداث المسجلة" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding TotalEventsCount}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 5: Recordings Count -->
            <Border Grid.Column="4" Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4,0,0,0">
                <StackPanel>
                    <TextBlock Text="مقاطع الفيديو المسجلة" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                    <TextBlock Text="{Binding RecordingsCount}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. MAIN CONTENT: SPLIT VIEW (TIMELINE & VIDEO PLAYER) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left: Activities Timeline -->
                <ColumnDefinition Width="1.2*" MinWidth="480" />
                <!-- Splitter -->
                <ColumnDefinition Width="10" />
                <!-- Right: Embedded Video Player -->
                <ColumnDefinition Width="1*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- ACTIVITIES TIMELINE PANE -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceLightBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Search / Filter bar -->
                        <RowDefinition Height="Auto" />
                        <!-- DataGrid -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter input -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#F8FAFC"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderLightBrush}"
                                 BorderThickness="1"
                                 Padding="12,8"
                                 FontSize="13">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Resources>
                                        <VisualBrush x:Key="CueBannerBrush" AlignmentX="Right" AlignmentY="Center" Stretch="None">
                                            <VisualBrush.Visual>
                                                <Label Content="🔍 ابحث في الأنشطة حسب اسم البرنامج، عنوان النافذة، أو مسار المجلد..." Foreground="#94A3B8" Padding="6,0" />
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                                        </Trigger>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="Background" Value="#FFFFFF" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>

                    <!-- Activities DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FilteredActivities}"
                              SelectedItem="{Binding SelectedActivity, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              Background="Transparent"
                              RowBackground="#FFFFFF"
                              AlternatingRowBackground="#F8FAFC"
                              BorderThickness="1"
                              BorderBrush="#E2E8F0"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Padding" Value="10,9" />
                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="MinHeight" Value="34" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EEF2FF" />
                                        <Setter Property="Foreground" Value="#1E1B4B" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F5F9" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <!-- Time Range -->
                            <DataGridTextColumn Header="الوقت" Binding="{Binding TimeRangeDisplay}" Width="145" />

                            <!-- Application Name (Badge) -->
                            <DataGridTemplateColumn Header="التطبيق" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding AppBadgeColor}" CornerRadius="5" Padding="8,2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ProcessName}" Foreground="White" FontWeight="Bold" FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Window Title -->
                            <DataGridTextColumn Header="عنوان النافذة" Binding="{Binding WindowTitle}" Width="1.5*" />

                            <!-- Duration -->
                            <DataGridTextColumn Header="المدة" Binding="{Binding DurationDisplay}" Width="90" />

                            <!-- Video Offset -->
                            <DataGridTextColumn Header="الإزاحة" Binding="{Binding OffsetDisplay}" Width="75" />

                            <!-- 1-Click Play Action Button -->
                            <DataGridTemplateColumn Header="التشغيل" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="▶ تشغيل"
                                                Style="{StaticResource PlayRowButtonStyle}"
                                                Command="{Binding DataContext.PlayActivityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding HasVideo}"
                                                ToolTip="القفز التلقائي المباشر إلى توقيت هذا الحدث في الفيديو" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" />

            <!-- RIGHT PANE: EMBEDDED VIDEO PLAYER -->
            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceLightBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Video Surface -->
                        <RowDefinition Height="*" />
                        <!-- Player Controls Bar -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Now Playing Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding NowPlayingTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding NowPlayingSub}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- Video Viewport Surface (Cinema Dark Container for crisp playback) -->
                    <Border Grid.Row="1" Background="#0B0F19" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,12">
                        <Grid>
                            <!-- MediaElement -->
                            <MediaElement x:Name="PlayerMediaElement"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Stop"
                                          ScrubbingEnabled="True"
                                          Stretch="Uniform" />

                            <!-- Placeholder when no video is loaded -->
                            <Border x:Name="PlaceholderBorder" Background="#0F172A" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🎥" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBlock Text="حدد نشاطاً من القائمة الجانبية" FontSize="14" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Center" />
                                    <TextBlock Text="انقر على '▶ تشغيل' للقفز التلقائي المباشر إلى توقيت الحدث" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Player Controls Bar (Light Theme) -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Scrubber Timeline Slider -->
                                <RowDefinition Height="Auto" />
                                <!-- Buttons & Volume -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Scrubber Slider -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SeekSlider"
                                        Grid.Column="0"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Cursor="Hand" />
                                <TextBlock Grid.Column="1" Text="{Binding VideoPositionDisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Transport Buttons -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Playback Buttons -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="⏪ -5ث" Style="{StaticResource ActionButtonStyle}" Command="{Binding JumpBackwardCommand}" Margin="0,0,6,0" ToolTip="تأخير 5 ثوانٍ" />
                                    <Button x:Name="PlayPauseButton" Content="▶ تشغيل" Style="{StaticResource AccentButtonStyle}" Command="{Binding PlayPauseCommand}" Width="85" Margin="0,0,6,0" />
                                    <Button Content="+5ث ⏩" Style="{StaticResource ActionButtonStyle}" Command="{Binding JumpForwardCommand}" ToolTip="تقديم 5 ثوانٍ" />
                                </StackPanel>

                                <!-- Volume Slider -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔊" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. BOTTOM STATUS BAR -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceLightBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="مراقب الأنشطة v1.0 • محلي وآمن 100%" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
